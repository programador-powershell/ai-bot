{
  "name": "aibot2",
  "private": true,
  "version": "0.1.0",
  "description": "AI-BOT 2 — OpenBot como chassis, kernel plugável clean-room, Needle Pro orquestradora e control plane distribuído, tudo em TypeScript",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "server",
    "worker-daemon",
    "agent-computer",
    "packages/harness-kernel",
    "packages/harness-openbot-bridge",
    "packages/domain/*",
    "packages/plugins/*",
    "packages/providers/*"
  ],
  "trustedDependencies": [
    "playwright"
  ],
  "scripts": {
    "test": "bun x vitest run",
    "typecheck": "bun x tsc --build"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
